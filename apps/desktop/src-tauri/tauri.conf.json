{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniPanel",
  "version": "0.1.0-alpha.1",
  "identifier": "dev.omnipanel.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm --dir ../deck build && pnpm dev",
    "beforeBuildCommand": "pnpm --dir ../deck build && pnpm build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "app", "dmg"],
    "category": "Utility",
    "publisher": "OmniPanel",
    "copyright": "MIT License",
    "shortDescription": "Turn any phone or tablet into a Stream Deck",
    "longDescription": "OmniPanel is a free, open-source Stream Deck alternative. Pair old phones and tablets over Wi-Fi or USB and use them as control decks: app volume, voice effects, OBS, Home Assistant, scripts, hotkeys and AI-generated actions.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": { "depends": ["pulseaudio-utils", "libasound2t64 | libasound2", "libssl3t64 | libssl3"] },
      "rpm": { "depends": ["pulseaudio-utils", "libasound.so.2()(64bit)", "libssl.so.3()(64bit)"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1MUZGODE4ODRDMjk4MjgKUldRb21NS0VHUGdmRmFVQWpKTFFJb28vZTJJL3V1Z3dHc1IxZlhnZmlkNzg0am9KMkMwdHQwYmUK",
      "endpoints": ["https://raw.githubusercontent.com/RealDoc06/OmniPanel/updater/latest.json"],
      "requireSignedVersion": true
    }
  }
}
